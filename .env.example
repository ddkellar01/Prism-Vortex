# PrismVortex Environment Configuration Template
ENVIRONMENT=production
DEBUG=false

# Google Gemini API Key (Required for Gemini 4 Argon thinking agents)
GEMINI_API_KEY=your_gemini_api_key_here
ARGON_MODEL_ID=gemini-4-argon

# Geospatial & People Search Services
EARTH_ENGINE_PROJECT=prism-vortex-geospatial
PEOPLE_SEARCH_API_URL=https://api.peoplesearch.internal/v1/query
PEOPLE_SEARCH_API_KEY=your_people_search_key_here

# Infrastructure
REDIS_URL=redis://redis:6379/0
HOST=0.0.0.0
PORT=8080
